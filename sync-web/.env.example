# Base URL of the Sync Express API.
VITE_API_BASE_URL=http://localhost:4000

# Displayed application name.
VITE_APP_NAME=Sync

# Socket.IO path exposed by the backend realtime gateway.
VITE_REALTIME_PATH=/realtime

# How often an active participant revalidates with the backend (seconds).
# Must stay well below the backend HEARTBEAT_TIMEOUT_SECONDS (default 90).
VITE_HEARTBEAT_INTERVAL_SECONDS=30

# Never put secrets here. Everything VITE_* is public to the browser.
