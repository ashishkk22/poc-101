# ---------------------------------------------------------------------------
# Sync — backend environment
# Copy to .env and fill in. Never commit real secrets.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# PostgreSQL — authoritative application state.
# Inside Docker Compose the host is the service name `postgres`.
DATABASE_URL=postgresql://timebound:timebound@localhost:5432/timebound_meet?schema=public
SHADOW_DATABASE_URL=

# Redis — realtime fan-out, rate limiting, BullMQ. Never authoritative.
REDIS_URL=redis://localhost:6379

# Better Auth. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-a-32-byte-random-string
BETTER_AUTH_URL=http://localhost:4000

# Browser origin allowed by CORS. Credentialed CORS forbids "*".
FRONTEND_ORIGIN=http://localhost:5173
# Public base URL used to build join links returned at invitation creation.
JOIN_URL_BASE=http://localhost:5173

# Provider adapters: mock | live
PROVIDER_MODE=mock
# captions = build the transcript from what people said | mock = sample text
TRANSCRIPTION_MODE=captions
# Mock failure injection (development/test only):
# HEALTHY | SLOW | JOIN_FAILURE | CAPTION_FAILURE | TRANSCRIPT_FAILURE | REVOKE_FAILURE
PROVIDER_FAILURE_MODE=HEALTHY
PROVIDER_SLOW_MS=2000

# Invitation credential lifetime relative to the call window.
INVITATION_TTL_MINUTES_AFTER_END=60

# Transcript retention.
TRANSCRIPT_RETENTION_DAYS=30

# Rate limiting (Redis backed).
RATE_LIMIT_ENABLED=true
RATE_LIMIT_GLOBAL_POINTS=300
RATE_LIMIT_GLOBAL_DURATION_SECONDS=60
RATE_LIMIT_JOIN_POINTS=10
RATE_LIMIT_JOIN_DURATION_SECONDS=60
RATE_LIMIT_HEARTBEAT_POINTS=120
RATE_LIMIT_HEARTBEAT_DURATION_SECONDS=60
RATE_LIMIT_AUTH_POINTS=20
RATE_LIMIT_AUTH_DURATION_SECONDS=60

# Attendance liveness.
HEARTBEAT_TIMEOUT_SECONDS=90

# Workers
RUN_WORKERS_IN_API_PROCESS=false
